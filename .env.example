# mediaman bootstrap configuration
# Copy this file to .env and edit. Do NOT commit .env.

# REQUIRED: Master secret for encryption and token signing. Must be strong
# (>=64 hex chars or >=43 URL-safe base64 chars). The placeholder below is
# intentionally short and repetitive so it fails the startup entropy check
# — you MUST replace it with a real value before starting the app.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MEDIAMAN_SECRET_KEY=REPLACE_THIS_NOW

# OPTIONAL: Web server port (default 8282)
MEDIAMAN_PORT=8282

# OPTIONAL: Host address uvicorn binds to.
#
# Leave this commented out for the standard Docker deployment — docker-compose.yml
# falls through to 0.0.0.0 (the only address reachable via the published port
# from the host). Setting MEDIAMAN_BIND_HOST=127.0.0.1 inside a container makes
# the service unreachable from the host.
#
# Bare-metal users who want localhost-only binding can uncomment the line below.
#MEDIAMAN_BIND_HOST=127.0.0.1

# OPTIONAL: Data directory for the SQLite database (default /data)
MEDIAMAN_DATA_DIR=/data

# OPTIONAL: Container clock for local-time output (default UTC). Any IANA name.
# mediaman does not read it: set the scan time zone in Settings (scan_timezone).
TZ=UTC

# OPTIONAL: Comma-separated list of trusted reverse-proxy IPs.
# Required if behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
# Example: MEDIAMAN_TRUSTED_PROXIES=10.0.0.1,10.0.0.2
MEDIAMAN_TRUSTED_PROXIES=

# The session cookie is always Secure, so logging in over plain http:// fails
# anywhere but localhost. Set to false to log in over plain HTTP (this also
# turns HSTS off); only for a LAN-only setup. Default: unset, always Secure.
#MEDIAMAN_FORCE_SECURE_COOKIES=false

# REQUIRED for scheduled deletion: colon-separated list of filesystem roots
# inside which mediaman is permitted to delete files (PATH-style).
# No scheduled deletion runs if unset. Inside the container, media is
# typically mounted at /media.
#
# Canonical separator is ':' — e.g. MEDIAMAN_DELETE_ROOTS=/media/movies:/media/tv
# Legacy ',' separator is still accepted but deprecated; a warning is
# logged when it is used. Do not mix separators.
# List library folders, not the mount itself: /, /media, /data, /mnt,
# /srv, /home and the standard system directories are refused.
# Example: MEDIAMAN_DELETE_ROOTS=/media/movies:/media/tv
MEDIAMAN_DELETE_ROOTS=

# ---------------------------------------------------------------------------
# Rarely needed. Each line shows its default; uncomment to change it.
# ---------------------------------------------------------------------------

# Comma-separated hostnames the app answers to; any other Host header is
# refused (localhost and 127.0.0.1 are always added). Where older TVs are on,
# it must also hold the host of the address TVs use, set in Settings.
# Default: unset, any host.
#MEDIAMAN_ALLOWED_HOSTS=mediaman.example.com

# Send Strict-Transport-Security on HTTPS requests. Turn on only once every
# request is HTTPS. Default: unset, off. MEDIAMAN_FORCE_SECURE_COOKIES=false
# turns it off regardless.
#MEDIAMAN_HSTS_ENABLED=true

# Add "preload" to the HSTS header; needs MEDIAMAN_HSTS_ENABLED=true.
# Default: unset, no preload.
#MEDIAMAN_HSTS_PRELOAD=true

# Largest request body accepted, in bytes. Default: 8388608 (8 MiB).
#MEDIAMAN_MAX_REQUEST_BYTES=8388608

# Media mount used for the disk-space figures in the storage panel and the
# newsletter. Default: /media.
#MEDIAMAN_MEDIA_PATH=/media

# Also refuse outbound requests to LAN (RFC1918) and loopback addresses, for
# when Plex, Radarr and the rest are not on the local network. Default: unset, off.
#MEDIAMAN_STRICT_EGRESS=1

# Comma-separated Cloudflare IP ranges whose CF-Connecting-IP header is trusted
# for the client's address; the peer must also be in MEDIAMAN_TRUSTED_PROXIES.
# Default: unset, the header is ignored.
#MEDIAMAN_CLOUDFLARE_PROXIES=173.245.48.0/20,103.21.244.0/22

# How tightly a login session is tied to the browser's IP and user agent:
# strict (full IP), loose (IPv4 /24, IPv6 /64) or off. Default: loose.
#MEDIAMAN_FINGERPRINT_MODE=loose

# Seconds a password re-entry stays valid for sensitive actions, 30 to 3600.
# Default: 300.
#MEDIAMAN_REAUTH_WINDOW_SECONDS=300

# mediaman runs as a single worker; a value above 1 stops startup.
# Default: unset, one worker.
#MEDIAMAN_WORKERS=1

# Set to 1 to build the app at import, for running
# `uvicorn mediaman.main:app` yourself. Default: unset.
#MEDIAMAN_EAGER_APP=1
